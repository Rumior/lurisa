generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model accounts {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  users             users   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model audit_log {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  resource  String?
  details   String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
}

model conversations {
  id        String     @id @default(uuid())
  userId    String
  title     String?
  summary   String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  users     users      @relation(fields: [userId], references: [id], onDelete: Cascade)
  memories  memories[]
  messages  messages[]

  @@index([userId])
  @@index([userId, updatedAt])
}

model devices {
  id            String     @id @default(uuid())
  userId        String
  name          String?
  fingerprint   String     @unique
  trusted       Boolean    @default(false)
  trustedAt     DateTime?
  lastSeenAt    DateTime   @default(now())
  lastIpAddress String?
  userAgent     String?
  createdAt     DateTime   @default(now())
  users         users      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions      sessions[]

  @@index([fingerprint])
  @@index([userId])
}

model goals {
  id          String         @id @default(uuid())
  userId      String
  title       String
  description String?
  category    MemoryCategory
  status      GoalStatus     @default(ACTIVE)
  targetDate  DateTime?
  completedAt DateTime?
  importance  Float          @default(0.5)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  users       users          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, status])
}

model insight_memories {
  id        String   @id @default(uuid())
  insightId String
  memoryId  String
  order     Int      @default(0)
  insights  insights @relation(fields: [insightId], references: [id], onDelete: Cascade)
  memories  memories @relation(fields: [memoryId], references: [id], onDelete: Cascade)

  @@unique([insightId, memoryId])
}

model insights {
  id               String             @id @default(uuid())
  userId           String
  suggestion       String
  reasoning        String
  confidence       Float              @default(0.8)
  createdAt        DateTime           @default(now())
  dismissedAt      DateTime?
  actedUponAt      DateTime?
  insight_memories insight_memories[]
  users            users              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model memories {
  id                                            String                  @id @default(uuid())
  userId                                        String
  category                                      MemoryCategory
  type                                          MemoryType
  statement                                     String
  confidence                                    Float                   @default(0.8)
  importance                                    Float                   @default(0.5)
  sourceConversationId                          String?
  reinforcementCount                            Int                     @default(0)
  lastReinforcedAt                              DateTime?
  status                                        MemoryStatus            @default(ACTIVE)
  createdAt                                     DateTime                @default(now())
  updatedAt                                     DateTime                @updatedAt
  expiresAt                                     DateTime?
  insight_memories                              insight_memories[]
  conversations                                 conversations?          @relation(fields: [sourceConversationId], references: [id])
  users                                         users                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  memory_edits                                  memory_edits[]
  memory_embeddings                             memory_embeddings?
  memory_links_memory_links_memoryIdATomemories memory_links[]          @relation("memory_links_memoryIdATomemories")
  memory_links_memory_links_memoryIdBTomemories memory_links[]          @relation("memory_links_memoryIdBTomemories")
  pending_confirmations                         pending_confirmations[]
  scheduled_intents                             scheduled_intents[]

  @@index([userId, category])
  @@index([userId, createdAt])
  @@index([userId, expiresAt])
  @@index([userId])
  @@index([userId, importance])
  @@index([userId, status])
  @@index([userId, type])
}

model memory_edits {
  id                String   @id @default(uuid())
  userId            String
  memoryId          String
  previousStatement String
  newStatement      String
  editedAt          DateTime @default(now())
  memories          memories @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  users             users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([memoryId])
  @@index([userId])
}

model memory_embeddings {
  id        String                 @id @default(uuid())
  memoryId  String                 @unique
  userId    String
  embedding Unsupported("vector")?
  createdAt DateTime               @default(now())
  memories  memories               @relation(fields: [memoryId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model memory_links {
  id                                        String           @id @default(uuid())
  userId                                    String
  memoryIdA                                 String
  memoryIdB                                 String
  relationType                              LinkRelationType
  strength                                  Float            @default(0.5)
  createdAt                                 DateTime         @default(now())
  memories_memory_links_memoryIdATomemories memories         @relation("memory_links_memoryIdATomemories", fields: [memoryIdA], references: [id], onDelete: Cascade)
  memories_memory_links_memoryIdBTomemories memories         @relation("memory_links_memoryIdBTomemories", fields: [memoryIdB], references: [id], onDelete: Cascade)

  @@unique([memoryIdA, memoryIdB, relationType])
  @@index([memoryIdA])
  @@index([memoryIdB])
  @@index([userId])
}

model messages {
  id             String        @id @default(uuid())
  conversationId String
  userId         String
  role           MessageRole
  content        String
  createdAt      DateTime      @default(now())
  conversations  conversations @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
  @@index([userId])
}

model notification_log {
  id          String           @id @default(uuid())
  userId      String
  type        NotificationType
  title       String
  body        String
  memoryId    String?
  intentId    String?
  sentAt      DateTime         @default(now())
  readAt      DateTime?
  dismissedAt DateTime?
  users       users            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, sentAt])
}

model pending_confirmations {
  id                 String    @id @default(uuid())
  userId             String
  existingMemoryId   String
  candidateStatement String
  relationType       String
  resolved           Boolean   @default(false)
  resolvedAt         DateTime?
  resolution         String?
  createdAt          DateTime  @default(now())
  memories           memories  @relation(fields: [existingMemoryId], references: [id], onDelete: Cascade)
  users              users     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([existingMemoryId])
  @@index([userId])
}

model scheduled_intents {
  id                  String       @id @default(uuid())
  userId              String
  sourceMemoryId      String
  triggerType         TriggerType
  triggerAt           DateTime
  actionType          ActionType
  expectsResponse     Boolean      @default(true)
  status              IntentStatus @default(PENDING)
  resolvedByMessageId String?
  recurrenceRule      String?
  createdAt           DateTime     @default(now())
  firedAt             DateTime?
  resolvedAt          DateTime?
  expiredAt           DateTime?
  memories            memories     @relation(fields: [sourceMemoryId], references: [id], onDelete: Cascade)
  users               users        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([triggerAt])
  @@index([userId])
  @@index([userId, status])
}

model sessions {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  deviceId     String?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())
  devices      devices? @relation(fields: [deviceId], references: [id])
  users        users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionToken])
  @@index([userId])
}

model timeline_events {
  id          String            @id @default(uuid())
  userId      String
  title       String
  description String?
  eventType   TimelineEventType
  eventDate   DateTime
  memoryId    String?
  importance  Float             @default(0.5)
  createdAt   DateTime          @default(now())
  users       users             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, eventDate])
  @@index([userId])
}

model users {
  id                    String                  @id @default(uuid())
  email                 String                  @unique
  name                  String?
  consentGiven          Boolean                 @default(false)
  consentGivenAt        DateTime?
  createdAt             DateTime                @default(now())
  dataRetentionDays     Int                     @default(365)
  emailVerified         DateTime?
  encryptedKeyWrap      String?
  image                 String?
  memoryPaused          Boolean                 @default(false)
  passwordHash          String?
  updatedAt             DateTime                @updatedAt
  timezone              String?                 @default("UTC")
  morningTime           String?                 @default("08:00")
  eveningTime           String?                 @default("20:00")
  accounts              accounts[]
  conversations         conversations[]
  devices               devices[]
  goals                 goals[]
  insights              insights[]
  memories              memories[]
  memory_edits          memory_edits[]
  notification_log      notification_log[]
  pending_confirmations pending_confirmations[]
  push_subscriptions    push_subscriptions[]
  scheduled_intents     scheduled_intents[]
  sessions              sessions[]
  timeline_events       timeline_events[]
  user_personal_models  user_personal_models?
  research_sessions     research_sessions[]
  relationship_stages   relationship_stages?

  @@index([email])
}

model verification_tokens {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model user_personal_models {
  id                      String   @id @default(uuid())
  userId                  String   @unique
  communicationStyle      String?
  communicationConfidence Float    @default(0)
  decisionMaking          String?
  decisionConfidence      Float    @default(0)
  workInterests           String?
  workConfidence          Float    @default(0)
  currentGoalsSummary     String?
  goalsConfidence         Float    @default(0)
  recurringConcerns       String?
  concernsConfidence      Float    @default(0)
  preferredInteraction    String?
  interactionConfidence   Float    @default(0)
  lifePhase               String?
  lifePhaseConfidence     Float    @default(0)
  importantRelationships  String?
  relationshipsConfidence Float    @default(0)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  users                   users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model relationship_stages {
  id                String   @id @default(uuid())
  userId            String   @unique
  stage             String   @default("NEW")
  firstContactAt    DateTime @default(now())
  messageCount      Int      @default(0)
  memoryCount       Int      @default(0)
  lastInteractionAt DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  users             users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model push_subscriptions {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  users     users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum ActionType {
  MORNING_ENCOURAGEMENT
  CHECK_IN_QUESTION
  ANNIVERSARY_NOTE
  REFLECTION_PROMPT
  GOAL_REMINDER
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  PAUSED
  ABANDONED
}

enum IntentStatus {
  PENDING
  FIRED
  RESOLVED
  EXPIRED
}

enum LinkRelationType {
  RELATED_TO
  SUPERSEDES
  DUPLICATE_OF
  CONTRADICTS
  PART_OF
  LED_TO
}

enum MemoryCategory {
  IDENTITY
  RELATIONSHIPS
  GOALS
  PROJECTS
  CAREER
  EDUCATION
  FINANCE
  HEALTH
  PREFERENCES
  HABITS
  TIMELINE
  ACHIEVEMENTS
  FAILURES
  LESSONS
  DREAMS
  VALUES
  STORIES
  EMOTIONS
  TRAVEL
  READING
  LEARNING
  SKILLS
  INTERESTS
  DAILY_REFLECTIONS
}

enum MemoryStatus {
  ACTIVE
  SUPERSEDED
  ARCHIVED
  DELETED
}

enum MemoryType {
  PERMANENT
  LONG_TERM
  TEMPORARY
  EMOTIONAL
  STORY
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum NotificationType {
  MORNING_CHECKIN
  EVENING_REFLECTION
  FOLLOW_UP
  MILESTONE
  ANNIVERSARY
  SYSTEM
}

enum TimelineEventType {
  MILESTONE
  ACHIEVEMENT
  LESSON
  STORY
  TRANSITION
  MEMORY
}

enum TriggerType {
  DATE
  RELATIVE
  RECURRENCE
}

// ============================================================================
// RESEARCH INTELLIGENCE MODELS
// ============================================================================

enum ResearchDepth {
  QUICK
  DEEP
  REPORT
}

enum ResearchStatus {
  PLANNING
  SEARCHING
  ANALYZING
  SYNTHESIZING
  COMPLETED
  FAILED
}

enum SourceType {
  PRIMARY
  SECONDARY
  TERTIARY
}

model research_sessions {
  id                    String           @id @default(uuid())
  userId                String
  query                 String
  objective             String?
  depth                 ResearchDepth    @default(QUICK)
  status                ResearchStatus   @default(PLANNING)
  personalInterpretation String?         @db.Text
  recommendation        String?          @db.Text
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  completedAt           DateTime?
  users                 users            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sources               research_sources[]
  findings              research_findings[]
  contradictions        research_contradictions[]

  @@index([userId])
  @@index([userId, status])
  @@index([userId, createdAt])
}

model research_sources {
  id              String      @id @default(uuid())
  sessionId       String
  title           String
  url             String
  publisher       String?
  author          String?
  publishedDate   DateTime?
  sourceType      SourceType  @default(SECONDARY)
  credibilityScore Float      @default(0.5)
  relevanceScore  Float       @default(0.5)
  content         String?     @db.Text
  rawClaims       String?     @db.Text
  session         research_sessions @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([sessionId, relevanceScore])
}

model research_findings {
  id              String      @id @default(uuid())
  sessionId       String
  category        String
  finding         String      @db.Text
  confidence      Float       @default(0.5)
  sourceIds       String[]
  personalRelevance String?   @db.Text
  session         research_sessions @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([sessionId, category])
}

model research_contradictions {
  id              String      @id @default(uuid())
  sessionId       String
  claimA          String      @db.Text
  claimB          String      @db.Text
  sourceAId       String
  sourceBId       String
  explanation     String      @db.Text
  session         research_sessions @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}