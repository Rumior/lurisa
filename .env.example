# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/lurisa?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/lurisa?sslmode=require"

# Redis (Upstash or local)
REDIS_URL="redis://localhost:6379"
REDIS_TOKEN=""

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-key-min-32-chars-long"

# Encryption
MASTER_KEY="your-master-encryption-key-min-32-chars"

# Admin (comma-separated emails)
ADMIN_EMAILS="admin@example.com"
ADMIN_ENABLED="true"

# Worker auth
WORKER_SECRET="worker-secret-key"

# Metrics
METRICS_PORT="9090"

# Optional: LLM providers (for Stage 2-4)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# App
APP_NAME="lurisa"
APP_URL="http://localhost:3000"

# ============================================================================
# RESEARCH INTELLIGENCE
# ============================================================================
# Search API provider: 'mock' (default, no real search), 'serper', or 'brave'
SEARCH_API_PROVIDER=mock
# Serper.dev API key (get from https://serper.dev)
SERPER_API_KEY=
# Maximum sources per research depth
RESEARCH_MAX_SOURCES_QUICK=5
RESEARCH_MAX_SOURCES_DEEP=12
RESEARCH_MAX_SOURCES_REPORT=20
