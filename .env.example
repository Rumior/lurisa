# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/lurisa?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/lurisa?sslmode=require"

# Redis (Upstash or local)
REDIS_URL="redis://localhost:6379"
REDIS_TOKEN=""

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-key-min-32-chars-long"

# Encryption
MASTER_KEY="your-master-encryption-key-min-32-chars"

# Admin (comma-separated emails)
ADMIN_EMAILS="admin@example.com"
ADMIN_ENABLED="true"

# Worker auth
WORKER_SECRET="worker-secret-key"

# Metrics
METRICS_PORT="9090"

# Optional: LLM providers (for Stage 2-4)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# App
APP_NAME="lurisa"
APP_URL="http://localhost:3000"
